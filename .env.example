# Copier ce fichier en .env avant de lancer le projet (cp .env.example .env)
# Ne jamais committer le fichier .env réel — il est ignoré via .gitignore

# --- Base de données (utilisées par docker-compose.yml) ---
POSTGRES_USER=lppc_user
POSTGRES_PASSWORD=lppc_dev_password
POSTGRES_DB=lppc_dev
POSTGRES_PORT=5433

# --- Chaîne de connexion utilisée par l'application ---
# Le port 5433 (et non 5432) évite un conflit si une instance PostgreSQL
# tourne déjà en natif sur la machine.
DATABASE_URL=postgresql://lppc_user:lppc_dev_password@localhost:5433/lppc_dev

# --- Application ---
PORT=3001
